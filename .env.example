# Copy this file to `.env` and fill in your keys.
# `.env` is gitignored — keys are loaded only by the Rust backend and are never sent to the frontend.

# Groq (LLM + Whisper STT) — https://console.groq.com/keys
GROQ_API_KEY=

# Google (Gemini LLM) — https://aistudio.google.com/apikey
GOOGLE_API_KEY=
